/* ============================================
   Firebase Storage Security Rules
   ============================================
   
   HOW TO DEPLOY:
   1. Install Firebase CLI: npm install -g firebase-tools
   2. Login: firebase login
   3. Initialize: firebase init storage (select your project)
   4. Copy these rules into your storage.rules file
   5. Deploy: firebase deploy --only storage
   ============================================ */

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Avatar uploads ──────────────────────────
    // Users can only upload/read/delete their own avatars
    
    match /avatars/{userId}/{allPaths=**} {
      // Any authenticated user can read any avatar (for profile display)
      allow read: if request.auth != null;
      
      // Users can only write to their own folder
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Users can only delete from their own folder
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Deny everything else ────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
