{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      "CHANGELOG.md",
      "DAILY_PLAN_IMPLEMENTATION.md",
      "SETUP.md",
      "WEAPON_SYSTEM_CHANGES.md",
      "**/node_modules/**",
      "src/**",
      "aminedjaghout16-alt-aim-platform-8cbea27/**",
      "n",
      ".git/**",
      ".gitignore",
      ".env",
      ".env.*",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local",
      ".firebaserc",
      "package.json",
      "package-lock.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
