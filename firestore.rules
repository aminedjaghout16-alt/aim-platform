rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Validate that displayName matches the user's profile (server-side read)
    function displayNameMatches(userId) {
      return request.resource.data.displayName ==
        get(/databases/$(database)/documents/users/$(userId)).data.displayName;
    }

    // Validate leaderboard entry fields (exact set allowed)
    function validLeaderboardEntryFields() {
      return request.resource.data.keys().hasOnly([
        'userId', 'displayName', 'score', 'accuracy', 'scenarioId',
        'weaponId', 'grade', 'createdAt'
      ]);
    }

    // Fields that clients must never modify via update
    function protectedFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email;
    }

    // ─── User Profiles ─────────────────────────────────────
    // Each user can only read and write their own document.
    // Protected fields (role, uid, email) cannot be changed client-side.
    match /users/{userId} {
      // Read: owner only — no cross-user reads allowed
      allow read: if isOwner(userId) || isAdmin();

      // Create: owner only; role must be absent or 'user'; uid must match
      allow create: if isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId);

      // Update: owner only; protected fields (role, uid, email) cannot change
      allow update: if isOwner(userId) && protectedFieldsUnchanged();

      // Delete: owner or admin
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ─── Training Results ──────────────────────────────────
    // Users can only access their own results.
    match /results/{resultId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.score is number &&
        request.resource.data.scenarioId is string;

      // Prevent changing the userId on an existing result
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ─── Leaderboards ──────────────────────────────────────
    // Structure: leaderboards/{scenarioId}/entries/{userId} (all-time)
    //            leaderboards/{scenarioId}/weeks/{weekId}/entries/{userId} (weekly)
    match /leaderboards/{scenarioId} {
      // Allow reading the scenario document itself (needed for sub-collection queries)
      allow read: if isAuthenticated();

      // All-time leaderboard
      match /entries/{entryUserId} {
        allow read: if isAuthenticated();

        // Create: user can only create their own entry
        allow create: if isAuthenticated() &&
          entryUserId == request.auth.uid &&
          validLeaderboardEntryFields() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 50 &&
          displayNameMatches(request.auth.uid) &&
          request.resource.data.score is number &&
          request.resource.data.score >= 0 &&
          request.resource.data.score <= 1000 &&
          request.resource.data.accuracy is number &&
          request.resource.data.accuracy >= 0 &&
          request.resource.data.accuracy <= 100 &&
          request.resource.data.scenarioId == scenarioId;

        // Update: user can only update their own entry with a STRICTLY higher score
        allow update: if isAuthenticated() &&
          entryUserId == request.auth.uid &&
          validLeaderboardEntryFields() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.score > resource.data.score &&
          request.resource.data.score >= 0 &&
          request.resource.data.score <= 1000 &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 50 &&
          displayNameMatches(request.auth.uid) &&
          request.resource.data.accuracy is number &&
          request.resource.data.accuracy >= 0 &&
          request.resource.data.accuracy <= 100 &&
          request.resource.data.scenarioId == scenarioId;

        // Delete: only admins can delete
        allow delete: if isAdmin();
      }

      // Weekly leaderboard buckets
      match /weeks/{weekId}/entries/{entryUserId} {
        allow read: if isAuthenticated();

        // Create: user can only create their own entry for this week
        allow create: if isAuthenticated() &&
          entryUserId == request.auth.uid &&
          validLeaderboardEntryFields() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 50 &&
          displayNameMatches(request.auth.uid) &&
          request.resource.data.score is number &&
          request.resource.data.score >= 0 &&
          request.resource.data.score <= 1000 &&
          request.resource.data.accuracy is number &&
          request.resource.data.accuracy >= 0 &&
          request.resource.data.accuracy <= 100 &&
          request.resource.data.scenarioId == scenarioId;

        // Update: user can only update with a STRICTLY higher score
        allow update: if isAuthenticated() &&
          entryUserId == request.auth.uid &&
          validLeaderboardEntryFields() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.score > resource.data.score &&
          request.resource.data.score >= 0 &&
          request.resource.data.score <= 1000 &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 50 &&
          displayNameMatches(request.auth.uid) &&
          request.resource.data.accuracy is number &&
          request.resource.data.accuracy >= 0 &&
          request.resource.data.accuracy <= 100 &&
          request.resource.data.scenarioId == scenarioId;

        // Delete: only admins can delete
        allow delete: if isAdmin();
      }
    }

    // ─── Playlists ─────────────────────────────────────────
    match /playlists/{playlistId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Prevent changing the ownerId on an existing playlist
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ─── Daily Plans ──────────────────────────────────────
    match /dailyPlans/{planId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.date is string &&
        request.resource.data.exercises is list;

      // Prevent changing the ownerId on an existing plan
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ─── Benchmarks ──────────────────────────────────────
    match /benchmarks/{benchmarkId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.overallScore is number &&
        request.resource.data.overallScore >= 0 &&
        request.resource.data.overallScore <= 1000 &&
        request.resource.data.status == 'completed';

      allow update: if false; // Completed benchmarks are immutable

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ─── Benchmark Attempts (incomplete) ─────────────────
    match /benchmarkAttempts/{attemptId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'incomplete';

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'incomplete' &&
        request.resource.data.userId == resource.data.userId;

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ─── Catch-all: deny everything else ─────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
