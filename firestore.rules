rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Validate that displayName matches the user's profile
    function displayNameMatches(userId) {
      return request.resource.data.displayName == 
        get(/databases/$(database)/documents/users/$(userId)).data.displayName;
    }

    // Validate leaderboard entry fields (exact set allowed)
    function validLeaderboardEntryFields() {
      return request.resource.data.keys().hasOnly([
        'userId', 'displayName', 'score', 'accuracy', 'scenarioId', 
        'weaponId', 'grade', 'createdAt'
      ]);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Create: owner only, role must be absent or 'user'
      allow create: if isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user');
      
      // Update: owner only, role cannot be changed (must remain the same or be absent in both)
      allow update: if isOwner(userId) &&
        (resource.data.role == request.resource.data.role ||
         (!('role' in resource.data) && !('role' in request.resource.data)));
      
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /results/{resultId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.score is number &&
        request.resource.data.scenarioId is string;

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ─── Leaderboards ──────────────────────────────────────
    // Structure: leaderboards/{scenarioId}/entries/{userId} (all-time)
    //            leaderboards/{scenarioId}/weeks/{weekId}/entries/{userId} (weekly)
    match /leaderboards/{scenarioId} {
      allow read: if isAuthenticated();

      // All-time leaderboard
      match /entries/{entryUserId} {
        allow read: if isAuthenticated();

        // Create: user can only create their own entry
        allow create: if isAuthenticated() &&
          entryUserId == request.auth.uid &&
          validLeaderboardEntryFields() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 50 &&
          displayNameMatches(request.auth.uid) &&
          request.resource.data.score is number &&
          request.resource.data.score >= 0 &&
          request.resource.data.score <= 1000 &&
          request.resource.data.accuracy is number &&
          request.resource.data.accuracy >= 0 &&
          request.resource.data.accuracy <= 100 &&
          request.resource.data.scenarioId == scenarioId;

        // Update: user can only update their own entry with a STRICTLY higher score
        allow update: if isAuthenticated() &&
          entryUserId == request.auth.uid &&
          validLeaderboardEntryFields() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.score > resource.data.score &&
          request.resource.data.score >= 0 &&
          request.resource.data.score <= 1000 &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 50 &&
          displayNameMatches(request.auth.uid) &&
          request.resource.data.accuracy is number &&
          request.resource.data.accuracy >= 0 &&
          request.resource.data.accuracy <= 100 &&
          request.resource.data.scenarioId == scenarioId;

        // Delete: only admins can delete
        allow delete: if isAdmin();
      }

      // Weekly leaderboard buckets
      match /weeks/{weekId}/entries/{entryUserId} {
        allow read: if isAuthenticated();

        // Create: user can only create their own entry for this week
        allow create: if isAuthenticated() &&
          entryUserId == request.auth.uid &&
          validLeaderboardEntryFields() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 50 &&
          displayNameMatches(request.auth.uid) &&
          request.resource.data.score is number &&
          request.resource.data.score >= 0 &&
          request.resource.data.score <= 1000 &&
          request.resource.data.accuracy is number &&
          request.resource.data.accuracy >= 0 &&
          request.resource.data.accuracy <= 100 &&
          request.resource.data.scenarioId == scenarioId;

        // Update: user can only update with a STRICTLY higher score
        allow update: if isAuthenticated() &&
          entryUserId == request.auth.uid &&
          validLeaderboardEntryFields() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.score > resource.data.score &&
          request.resource.data.score >= 0 &&
          request.resource.data.score <= 1000 &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 50 &&
          displayNameMatches(request.auth.uid) &&
          request.resource.data.accuracy is number &&
          request.resource.data.accuracy >= 0 &&
          request.resource.data.accuracy <= 100 &&
          request.resource.data.scenarioId == scenarioId;

        // Delete: only admins can delete
        allow delete: if isAdmin();
      }
    }

    match /playlists/{playlistId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
